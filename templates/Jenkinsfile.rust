pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    stages {
        stage('Compilar') {
            steps {
                sh 'cargo build --release'
            }
        }
        stage('Probar') {
            steps {
                sh 'cargo test'
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
