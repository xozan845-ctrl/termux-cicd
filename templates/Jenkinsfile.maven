pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    stages {
        stage('Compilar y probar') {
            steps {
                sh 'if [ -x ./mvnw ]; then ./mvnw -B verify; else mvn -B verify; fi'
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
